# DJ-JK environment template — copy to .env and fill in.

# PostgreSQL connection string. Works with local Postgres or Neon.
# Local example: postgres://USER@127.0.0.1:5432/djjk
DATABASE_URL=postgres://USER@127.0.0.1:5432/djjk

# Optional: session secret for production (generated; keep secret).
# SESSION_SECRET=
